# App Settings
JWT_SECRET=replace-with-a-long-random-secret
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL_MS=1000
RATE_LIMIT_MAX=20
NODE_ENV="development" # or production
SANDBOX_SETTLEMENT_MODE=false
# Required only by the Portal-backend relay in local sandbox testing; keep this secret out of clients.
SANDBOX_SETTLEMENT_SERVICE_KEY=replace-with-a-long-random-secret
# Required for Portal-to-Web Purchase Order cancellation/refund orchestration.
PORTAL_COMMERCE_SERVICE_KEY=replace-with-a-long-random-secret
# Database
DB_NAME=kompra_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kompra_db?schema=public
DATABASE_URL="postgresql://kompra:kompra_dev@localhost:5433/kompra_dev"
# Email (optional)
EMAIL_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
PAYMENT_PROVIDER=PAYMAYA
PAYMENT_ENV=SANDBOX
# Non-secret reconciliation label. This backend owns the Kompra PH Maya application only.
MAYA_APPLICATION_CHANNEL=KOMPRA_PH
MAYA_PUBLIC_KEY=replace-with-your-kompra-ph-maya-public-key
MAYA_SECRET_KEY=replace-with-your-kompra-ph-maya-secret-key
MAYA_SUCCESS_URL=http://localhost:3000/wholesale/payments/success
MAYA_CANCEL_URL=http://localhost:3000/wholesale/payments/cancel
# Maya Checkout is documented as valid for one hour; keep reuse below 60 minutes.
MAYA_CHECKOUT_REUSE_MINUTES=55
# During free-ngrok development, point the one hostname to this backend on port 8000.
# Register https://<current-ngrok-host>/api/payments/webhook/maya in the Kompra PH Maya app.
