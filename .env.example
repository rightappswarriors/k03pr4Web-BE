# App Settings
JWT_SECRET=replace-with-a-long-random-secret
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL_MS=1000
RATE_LIMIT_MAX=20
NODE_ENV="development" # or production
SANDBOX_SETTLEMENT_MODE=false
# Required only by the Portal-backend relay in local sandbox testing; keep this secret out of clients.
SANDBOX_SETTLEMENT_SERVICE_KEY=replace-with-a-long-random-secret
# Database
DB_NAME=kompra_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kompra_db?schema=public
DATABASE_URL="postgresql://kompra:kompra_dev@localhost:5433/kompra_dev"
# Email (optional)
EMAIL_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
PAYMENT_PROVIDER=PAYMAYA
PAYMENT_ENV=SANDBOX
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_SUCCESS_URL=http://localhost:3000/wholesale/payments/success
MAYA_CANCEL_URL=http://localhost:3000/wholesale/payments/cancel
